# =============================================================================
# Kittyp Frontend (Vite + React) — environment template
# Copy:  cp .env.example .env.devlocal
# Then fill values. NEVER commit real .env* files (except this example).
#
# Rules:
# - Only VITE_* (and TEMP_* if used) are exposed to the browser bundle.
# - NEVER put: Razorpay KEY SECRET, JWT, DB password, AWS secret, Zoho key,
#   Firebase private key / service account, SMS password, Shiprocket password.
# =============================================================================

# -----------------------------------------------------------------------------
# API
# Local HTTPS FE (https://localhost:8080) proxies /api → http://127.0.0.1:8082.
# Prefer same-origin path or empty host to avoid mixed-content; absolute URL OK for pure HTTP.
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1
# Optional scratch override used by some local helpers (not required in prod)
TEMP_API_BASE_URL=http://127.0.0.1:8082/api/v1

# -----------------------------------------------------------------------------
# Feature flags (strings "true"/"false" or "1"/"0")
# -----------------------------------------------------------------------------
# Enables ecommerce/storefront routes
VITE_FEATURE_ECOMMERCE=false
# Alias accepted by feature config
VITE_ENABLE_STORE=false
# FCM debug overlay (emails redacted in UI). Keep false in prod.
VITE_DEBUG_FCM=false

# -----------------------------------------------------------------------------
# Razorpay Checkout — KEY ID only (public). Key SECRET is backend-only.
# Dashboard → API Keys → Key Id (rzp_test_… / rzp_live_…)
# -----------------------------------------------------------------------------
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# -----------------------------------------------------------------------------
# Google SSO — backend-mediated start URLs (not OAuth client secrets)
# -----------------------------------------------------------------------------
VITE_GOOGLE_SSO_URL=http://127.0.0.1:8082/oauth2/authorization/google
VITE_GOOGLE_SSO_URL_DEV=
VITE_GOOGLE_SSO_URL_LOCAL=

# -----------------------------------------------------------------------------
# Firebase Web SDK (public client config). Restrict by HTTP referrer in GCP.
# Console → Project settings → Your apps → Web app
# -----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=change-me
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
# Web Push certificates → Key pair (public VAPID key)
VITE_FIREBASE_VAPID_KEY=change-me

# -----------------------------------------------------------------------------
# Meta / WhatsApp Embedded Signup (public app id + config id)
# REQUIRED after audit — no hardcoded fallbacks in source.
# Meta for Developers → App → WhatsApp → Embedded Signup configuration
# -----------------------------------------------------------------------------
VITE_META_APP_ID=
VITE_META_CONFIG_ID=
# Alias for VITE_META_CONFIG_ID (either works)
VITE_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=

# -----------------------------------------------------------------------------
# reCAPTCHA v3/enterprise site key (public). Secret stays on backend if used.
# -----------------------------------------------------------------------------
VITE_RECAPTCHA_SITE_KEY=
