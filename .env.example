# Kittyp frontend — copy to `.env.devlocal` / `.env.development` / `.env.production`
# Never commit real values. Only VITE_* vars are exposed to the browser.

VITE_API_BASE_URL=http://localhost:8082
TEMP_API_BASE_URL=http://localhost:8082

VITE_FEATURE_ECOMMERCE=true
VITE_ENABLE_STORE=false
VITE_DEBUG_FCM=false

# Razorpay Key ID only (never put the Key Secret in the frontend)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

VITE_GOOGLE_SSO_URL=http://localhost:8082/oauth2/authorization/google
VITE_GOOGLE_SSO_URL_DEV=
VITE_GOOGLE_SSO_URL_LOCAL=

# Firebase web config — restrict by HTTP referrer / domain in Google Cloud
VITE_FIREBASE_API_KEY=change-me
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_FIREBASE_VAPID_KEY=change-me

# Meta / WhatsApp embedded signup (public app/config ids; app secret stays on BE)
VITE_META_APP_ID=0000000000000000
VITE_META_CONFIG_ID=0000000000000000
VITE_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=0000000000000000

VITE_RECAPTCHA_SITE_KEY=change-me
