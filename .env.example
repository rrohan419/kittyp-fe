# Kittyp frontend (Vite) — copy to .env.devlocal / .env.development / .env.production
# Only VITE_* values are embedded in the browser bundle. Never put server secrets here
# (no Razorpay key secret, JWT secret, DB password, Zoho key, AWS secret, Firebase private key).

# API (same-origin proxy in local HTTPS: leave host empty or use /api path as configured)
VITE_API_BASE_URL=http://localhost:8082
TEMP_API_BASE_URL=http://localhost:8082

# Feature flags
VITE_FEATURE_ECOMMERCE=true
VITE_ENABLE_STORE=false
VITE_DEBUG_FCM=false

# Razorpay KEY ID only (rzp_test_… / rzp_live_…). Key SECRET stays on the backend.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# Google SSO entry (backend-mediated OAuth start URL — not a client secret)
VITE_GOOGLE_SSO_URL=http://localhost:8082/oauth2/authorization/google
VITE_GOOGLE_SSO_URL_DEV=
VITE_GOOGLE_SSO_URL_LOCAL=

# Firebase web config (restrict by HTTP referrer in Google Cloud Console)
VITE_FIREBASE_API_KEY=change-me
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_FIREBASE_VAPID_KEY=change-me

# Meta / WhatsApp embedded signup (public app + config ids; app secret on BE only)
VITE_META_APP_ID=
VITE_META_CONFIG_ID=
VITE_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=

# reCAPTCHA site key (public)
VITE_RECAPTCHA_SITE_KEY=
